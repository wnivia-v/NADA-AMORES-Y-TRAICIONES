{
  "name": "nada-amores-y-traiciones",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Antigravity",
  "description": "NADA Amores y Traiciones v2 — Deteccion de Fraude en Tiempo Real con IA",
  "scripts": {
    "mediapipe:assets": "node scripts/prepare-mediapipe.mjs",
    "worker:build": "node scripts/build-vision-worker.mjs",
    "predev": "npm run mediapipe:assets",
    "dev": "concurrently -k \"node scripts/build-vision-worker.mjs --dev --watch\" \"vite\"",
    "prebuild": "npm run mediapipe:assets && npm run worker:build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src server bench",
    "test": "vitest run",
    "test:db": "TEST_DATABASE_URL=\"$TEST_DATABASE_URL\" vitest run",
    "db:up": "pg_ctlcluster 16 main start || true",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:watch": "vitest",
    "server:dev": "tsx watch server/src/index.ts",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --format=esm --outfile=server/dist/index.js",
    "server:start": "node server/dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "bench:fusion": "tsx bench/fusion.ts",
    "bench:fusion-sweep": "tsx bench/fusion-sweep.ts",
    "bench:regex": "tsx bench/measure-regex.ts",
    "bench:regions": "tsx bench/lexicon-regions.ts",
    "bench:redteam": "tsx bench/injection-redteam.ts",
    "bench:vision": "node bench/chromium-smoke.mjs",
    "preview:deliberacion": "tsx bench/deliberation-preview.tsx",
    "skills:setup": "bash scripts/setup-skills.sh",
    "backoffice": "tsx bench/backoffice.ts",
    "icon": "node scripts/generate-icon.mjs",
    "electron:dev": "npm run icon && tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run icon && tsc -p tsconfig.electron.json && tsc -b && vite build && electron-builder --win --x64",
    "electron:preview": "npm run icon && tsc -p tsconfig.electron.json && tsc -b && vite build && electron .",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "build": {
    "appId": "com.antigravity.nada",
    "productName": "NADA Shield",
    "copyright": "Copyright (c) 2026 Antigravity",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "NADA-Shield-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NADA Shield"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@huggingface/transformers": "^3.7.6",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@prisma/client": "^6.19.3",
    "@tensorflow/tfjs": "^4.22.0",
    "firebase": "^11.0.0",
    "lucide-react": "^0.460.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
