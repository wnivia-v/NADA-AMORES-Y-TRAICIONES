{
  "name": "nada-amores-y-traiciones-kiro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Antigravity — Hackaton Kiro 2026",
  "description": "NADA Amores y Traiciones v2 — Deteccion de Fraude en Tiempo Real con IA (Hackaton Kiro, 23 Julio 2026)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/generate-icon.mjs",
    "electron:dev": "npm run icon && tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run icon && tsc -p tsconfig.electron.json && tsc -b && vite build && electron-builder --win --x64",
    "electron:preview": "npm run icon && tsc -p tsconfig.electron.json && tsc -b && vite build && electron ."
  },
  "build": {
    "appId": "com.antigravity.nada",
    "productName": "NADA Shield",
    "copyright": "Copyright (c) 2026 Antigravity",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "NADA-Shield-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NADA Shield"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@tensorflow/tfjs": "^4.22.0",
    "firebase": "^11.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
