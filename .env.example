# =============================================================================
# NADA AMORES Y TRAICIONES KIRO — Variables de Entorno
# Hackaton Kiro — 23 Julio 2026
# Copia este archivo como .env.local y rellena los valores.
# =============================================================================

# Firebase (console.firebase.google.com) — Necesario para Gemini AI
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Safe Browsing API (console.cloud.google.com)
VITE_SAFE_BROWSING_API_KEY=

# =============================================================================
# Proveedores de IA Adicionales (Opcional)
# Configura uno o mas para multi-AI con fallback/race/consenso
# =============================================================================

# reCAPTCHA Enterprise (para App Check de Firebase AI Logic)
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Groq — TIER GRATUITO, sin tarjeta de credito (https://console.groq.com)
# 30 consultas/minuto y 1000/dia en el momento de escribir esto.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude — DE PAGO (https://console.anthropic.com)
# ATENCION: Vite inyecta esta clave en el bundle del cliente en texto plano.
# No la configures en un despliegue publico; cualquiera podria extraerla.
VITE_CLAUDE_API_KEY=
VITE_CLAUDE_MODEL=claude-sonnet-4-20250514

# AWS Bedrock (via API Gateway proxy — no exponer credenciales AWS en frontend)
# Endpoint: tu API Gateway URL que proxea a Bedrock
VITE_BEDROCK_ENDPOINT=
VITE_BEDROCK_API_KEY=
VITE_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
