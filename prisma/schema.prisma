// =============================================================================
// Esquema de NADA — Modo B
//
// Hasta ahora este archivo tenia cero modelos: declaraba el datasource y nada
// mas. Aqui esta lo que el Modo B necesita guardar, que es poco a proposito.
//
// Dos reglas gobiernan lo que hay y lo que no:
//
//   1. §4.1 — NADA BIOMETRICO. No hay tabla de frames, ni de audio, ni de
//      landmarks, ni un campo donde pudieran caber. Un reporte del escudo de
//      video llega con `content` a null y asi se guarda. No es una omision que
//      alguien pueda "completar" luego: completarla seria reescribir el
//      producto.
//   2. BORRAR TIENE QUE BORRAR. Sin cuentas, lo que agrupa los datos de una
//      persona es `installId`: borrar es un deleteMany por ese campo, no
//      acordarse de siete sitios. Es mas debil que una cuenta y hay que
//      decirlo — quien tenga ese identificador puede borrar esos reportes.
//
// ESTADO HISTORICO: el esquema estuvo escrito antes de tener base de datos. Hoy
// corre sobre PostgreSQL real, y la misma bateria de tests se ejecuta contra el
// almacen en memoria y contra la base.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Un reporte enviado por alguien que acepto contribuir.
model Report {
  id        String   @id
  /// Instalacion que lo envio. Sustituye a la cuenta con correo: identifica,
  /// no autentica. Ver el comentario en server/src/store/types.ts.
  installId String
  createdAt DateTime @default(now())

  /// text | voice | image | clipboard | screen | video
  surface   String
  /// correct | incorrect
  judgment  String
  /// false-positive | false-negative | null si acerto
  errorKind String?

  // --- Lo que se enseño ---
  band         String
  riskScore    Int
  alerted      Boolean
  corroborated Boolean
  scanSource   String

  // --- Por que se decidio (el rastro) ---
  /// IDs de las entradas del lexico que coincidieron. Lo accionable.
  lexiconIds    String[]
  combos        String[]
  dampened      String[]
  localScore    Int
  llmScore      Int?
  injectionHits String[]
  /// [{ type, evidence }] — lo que sostuvo la fusion.
  drivers       Json

  // --- Contenido ---
  /// Comentario libre del usuario.
  note    String?
  /// El texto analizado. SIEMPRE null cuando surface = 'video' (§4.1).
  /// El servidor lo impone al recibir; el cliente no es una frontera de confianza.
  content String?

  // --- Contexto, para poder agrupar y fechar contra el codigo ---
  region         String
  language       String
  appVersion     String
  /// Huella del lexico vigente. Sin esto no se sabe si la queja ya se arreglo.
  lexiconVersion String

  /// Cuando lo miro el backoffice. Null = sin revisar.
  reviewedAt DateTime?

  // --- Contexto del aparato ---
  //
  // Todo null cuando la telemetria esta apagada en ajustes. Un reporte sin
  // contexto sigue siendo util: se pierde poder distinguir si cien quejas
  // iguales vienen de cien sitios o de uno, no la queja en si.
  /// web | android | electron
  platform    String?
  os          String?
  deviceModel String?
  /// La lee el servidor de la conexion. NUNCA la manda el cliente.
  ip          String?

  // Los dos indices que sostienen el limite de ritmo: se cuenta por instalacion
  // Y por IP en la misma consulta, y sin ellos seria un recorrido completo de la
  // tabla en cada reporte.
  @@index([installId])
  @@index([ip])
  @@index([errorKind, lexiconVersion])
  @@index([reviewedAt])
  @@map("reports")
}
